# Private inputs: only the placeholder template is committed
!raw_input_data/
raw_input_data/*
!raw_input_data/data_paths.R.example

# Pipeline outputs are ignored by default, as most are individual-level data
# or large intermediates. Only small, aggregate, SNP- or allele-level summary
# files are committed.
data_prep/*/output/*

!data_prep/study_cohort_genetics/output/clumping_r2_080.clumps
!data_prep/study_cohort_genetics/output/cojo_haplotypes_minor_allele.csv
!data_prep/study_cohort_genetics/output/hla_alleles_snps_regression.csv
!data_prep/nbb_replication_cohort/output/microglia_neuropathology_regression.csv

!data_prep/study_cohort_genetics/output/haplotype_ld/
data_prep/study_cohort_genetics/output/haplotype_ld/*
!data_prep/study_cohort_genetics/output/haplotype_ld/hla_alleles_snps_ld_matrix.ld
!data_prep/study_cohort_genetics/output/haplotype_ld/hla_alleles_snps_ld_matrix.bim

!data_prep/study_cohort_genetics/output/regional_ld/
data_prep/study_cohort_genetics/output/regional_ld/*
!data_prep/study_cohort_genetics/output/regional_ld/regional_ld_pairs.ld

# Never commit: study_cohort_samples.txt (participant IDs) and the combined
# per-participant files of the 100-plus and NBB cohorts. Their output folders
# contain a README instead.
!data_prep/100plus_study_cohort/output/README.md
!data_prep/nbb_replication_cohort/output/README.md
